@page
@model ZooWeb.Pages.FeedingPatterns.IndexModel
@{
}

<br>
<h2>List of FeedingPatterns</h2>
<a class='btn btn-primary btn-sm' href="/FeedingPatterns/Create">New Feeding Pattern</a>
<table class="table">
<thead>
<tr>
<th>Animal ID</th>
<th>Meal</th>
<th>Portion</th>
<th>Feeding Days</th>
<th>Feeding Time</th>
</tr>
</thead>
  <tbody>
@foreach (var item in Model.listFeedingPatterns)
{
  <tr>
    <td>@item.AnimalId</td>
    <td>@item.Meal</td>
    <td>@item.Portion</td>
    <td>@string.Join(", ", item.ScheduleDays)</td>
    <td>@item.ScheduleTime</td>
    <td>
    <a class='btn btn-primary btn-sm' href="/FeedingPatterns/Edit?id=@item.AnimalId">Edit</a>
    <a id='deleteAnchor_@item.AnimalId' class='btn btn-danger btn-sm' onclick="confirmDelete(@item.AnimalId, true)">Delete</a>

    <span id="confirmDeleteAnchor_@item.AnimalId" style="display:none">
    <span>Are you sure?</span>
    <form method="post" asp-page-handler="Delete" style="display:inline;">
    <input type="hidden" name="id" value="@item.AnimalId" />
    <button type="submit" class="btn btn-danger">Yes</button>
    </form>
    <a href="#" class="btn btn-primary" onclick="confirmDelete('@item.AnimalId', false)">No</a>
    </span>
    </td>
    </tr>
}
</tbody>
</table>


<script src="~js/ConfirmDelete.js"></script>
