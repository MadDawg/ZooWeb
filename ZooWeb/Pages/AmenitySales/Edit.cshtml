@page
@model ZooWeb.Pages.AmenitySales.EditModel
@{
}

<br>
<h2>Edit Amenity Sale</h2>

@if (Model.errorMsg.Length > 0)
{
	<div class="alert alert-warning alert-dismissible fade show" role="alert">
		<strong>@Model.errorMsg</strong>
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}

<form method="POST">
	<div class="row mb-3">
		<label class="col-sm-3 col-form-label">Employee ID</label>
		<div class="col-sm-6">
			<select class="form-control" name="EID" value="@Model.info.EID">
				<option value="">-</option>
				@foreach (EmployeeListTable item in Model.employeeList)
				{
					<option value="@(item.Key)">@item.Display</option>
				}
			</select>
		</div>
	</div>
	<div class="row mb-3">
		<label class="col-sm-3 col-form-label">Location ID</label>
		<div class="col-sm-6">
			<input type="text" class="form-control" name="LocationID" value="@Model.info.LocationID">
		</div>
	</div>
	<div class="row mb-3">
		<label class="col-sm-3 col-form-label">Sale Type</label>
		<div class="col-sm-6">
			<input type="text" class="form-control" name="SaleType" value="@Model.info.SaleType">
		</div>
	</div>
	<div class="row mb-3">
		<label class="col-sm-3 col-form-label">Sale Date</label>
		<div class="col-sm-6">
			<input type="text" class="form-control" name="SaleDate" value="@Model.info.SaleDate" disabled>
		</div>
	</div>
	<div class="row mb-3">
		<label class="col-sm-3 col-form-label">Total</label>
		<div class="col-sm-6">
			<input type="text" class="form-control" name="Total" value="@Model.info.SaleTotal">
		</div>
	</div>
	<div class="row mb-3">
		<!-- <label class="col-sm-3 col-form-label">Receipt Number</label> -->
		<div class="col-sm-6">
			<input type="hidden" class="form-control" name="SaleId" value="@Model.info.SaleId">
		</div>
	</div>

	@if (Model.successMsg.Length > 0)
	{
		<div class="row mb-3">
			<div class="col-sm-9">
				<div class="alert alert-success alert-dismissible fade show" role="alert">
					<strong>@Model.successMsg</strong>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
			</div>
		</div>
	}

	<div class="row mb-3">
		<div class="offset-sm-3 col-sm-3 d-grid">
			<button type="submit" class="btn btn-primary">Submit</button>
		</div>
		<div class="col-sm-3 d-grid">
			<a class="btn btn-outline-primary" href="/AmenitySales" role="button">Cancel</a>
		</div>
	</div>
</form>
