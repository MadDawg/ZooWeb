@page
@model ZooWeb.Pages.TicketSales.IndexModel
@{
}

<br>
<h2>List of Ticket Sales</h2>
<a class='btn btn-primary btn-sm' href="/TicketSales/Create">New Ticket Sale</a>
<table class="table">
	<thead>
		<tr>
			<th>Ticket ID</th>
			<th>Pass Type</th>
			<th>Visitor Phone</th>
			<th>Employee ID</th>
			<th>Sale Total</th>
			<th>Sale Date</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.ListTicketSales)
		{
			<tr>
				<td>@item.TicketID</td>
				<td>@item.PassType</td>
				<td>@item.VisitorPn</td>
				<td>@item.EmployeeID</td>
				<td>@item.SaleTotal</td>
				<td>@item.SaleDate</td>


				<td>
					<a class='btn btn-primary btn-sm' href="/TicketSales/Edit?id=@item.TicketID">Edit</a>
          <a id='deleteAnchor_@item.TicketID' class='btn btn-danger btn-sm' onclick="confirmDelete(@item.TicketID, true)">Toggle</a>

          <span id="confirmDeleteAnchor_@item.TicketID" style="display:none">
          <span>Are you sure?</span>
          <form method="post" asp-page-handler="ToggleStatus" style="display:inline;">
          <input type="hidden" name="id" value="@item.TicketID" />
          <button type="submit" class="btn btn-danger">Yes</button>
          <a href="#" class="btn btn-primary" onclick="confirmDelete('@item.TicketID', false)">No</a>
				</td>
			</tr>
		}
	</tbody>
</table>
