@page
@model ZooWeb.Pages.Restricted.IndexModel
@{
}

<br>
<h2>List of Restrictions</h2>
<a class='btn btn-primary btn-sm' href="/Restricted/Create">New Restriction</a>
<table class="table">
<thead>
<tr>
<th>Location ID</th>
<th>Close Date</th>
<th>Reopen Date</th>
</tr>
</thead>
  <tbody>
@foreach(var item in Model.Restrictions)
{
  <tr>
    <td>@item.Location_ID</td>
    <td>@item.Close_date</td>
    <td>@item.Reopen_date</td>
    <td>
    <a class='btn btn-primary btn-sm' href="/Restricted/Edit?id=@item.Location_ID">Edit</a>
    <a id='deleteAnchor_@item.Location_ID' class='btn btn-danger btn-sm' onclick="confirmDelete(@item.Location_ID, true)">Delete</a>
    <span id="confirmDeleteAnchor_@item.Location_ID" style="display:none">
    <span>Are you sure?</span>
    <form method="post" asp-page-handler="Delete" style="display:inline;">
    <input type="hidden" name="id" value="@item.Location_ID" />
    <button type="submit" class="btn btn-danger">Yes</button>
    </form>
    <a href="#" class="btn btn-primary" onclick="confirmDelete('@item.Location_ID', false)">No</a>
    </span>
    </td>
    </tr>
}
</tbody>
</table>

<script src="~/js/ConfirmDelete.js"></script>
