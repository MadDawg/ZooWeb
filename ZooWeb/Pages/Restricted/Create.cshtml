@page
@model ZooWeb.Pages.Restricted.CreateModel
@{
}

<br>
<h2>Add Restriction</h2>
<br>

@if (Model.errorMsg.Length > 0)
{
	<div class="alert alert-warning alert-dismissible fade show" role="alert">
		<strong>@Model.errorMsg</strong>
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}

<form method="POST">
	<div class="row mb-3">
		<label class="col-sm-3 col-form-label">Location</label>
		<div class="col-sm-6">
			<select class="form-control" name="Location_ID" value="@Model.info.LocationId">
				<option value="">-</option>
				@foreach (var item in Model.enclosureList)
				{
					<option value="@(item.Key)">@item.Display</option>
				}
			</select>
		</div>
	</div>
	<div class="row mb-3">
		<label class="col-sm-3 col-form-label">Close Date</label>
		<div class="col-sm-6">
			<input type="datetime-local" class="form-control" name="Close_date" value="@Model.info.CloseDate">
		</div>
	</div>
	<div class="row mb-3">
		<label class="col-sm-3 col-form-label">Reopen Date</label>
		<div class="col-sm-6">
			<input type="datetime-local" class="form-control" name="Reopen_date" value="@Model.info.ReopenDate">
		</div>
	</div>

	@if (Model.successMsg.Length > 0)
	{
	<div class="row mb-3">
		<div class="col-sm-9">
			<div class="alert alert-success alert-dismissible fade show" role="alert">
				<strong>@Model.successMsg</strong>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
			</div>
		</div>
	</div>
	}

	<div class="row mb-3">
		<div class="offset-sm-3 col-sm-3 d-grid">
			<button type="submit" class="btn btn-primary">Submit</button>
		</div>
		<div class="col-sm-3 d-grid">
			<a class="btn btn-outline-primary" href="/" role="button">Cancel</a>
		</div>
	</div>
</form>
