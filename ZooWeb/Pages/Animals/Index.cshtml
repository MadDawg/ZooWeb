@page
@model ZooWeb.Pages.Animals.IndexModel
@{
}

<br>
<h2>List of Animals</h2>
<a class='btn btn-primary btn-sm' href="/Animals/Create">New Animal</a>
<table class="table">
<thead>
<tr>
<th>Animal Id</th>
<th>Animal Name</th>
<th>Scientific Name</th>
<th>Common Name</th>
<th>Sex</th>
<th>Birth Date</th>
<th>Status</th>
<th>Location ID</th>
</tr>
</thead>
<tbody>
@foreach (var item in Model.listAnimals)
{
  <tr>
    <td>@item.AnimalId</td>
    <td>@item.Name</td>
    <td>@item.ScientificName</td>
    <td>@item.CommonName</td>
    <td>@item.Sex</td>
    <td>@item.BirthDate.ToString("yyyy-MM-dd")</td>
    <td>@item.Status</td>
    <td>@item.LocationId</td>
    <td>
    <a class='btn btn-primary btn-sm' href="/Animals/Edit?id=@item.AnimalId">Edit</a>
    <a id='deleteAnchor_@item.AnimalId' class='btn btn-danger btn-sm' onclick="confirmDelete(@item.AnimalId, true)">Toggle</a>
    <span id="confirmDeleteAnchor_@item.AnimalId" style="display:none">
    <span>Are you sure?</span>
    <form method="post" asp-page-handler="ToggleStatus" style="display:inline;">
    <input type="hidden" name="id" value="@item.AnimalId" />
    <button type="submit" class="btn btn-danger">Yes</button>
    </form>
    <a href="#" class="btn btn-primary" onclick="confirmDelete('@item.AnimalId', false)">No</a>
    </span>
    </td>
    </tr>
}
</tbody>
</table>


<script src ="~/js/ConfirmDelete.js"></script>

